          "translate": true
        },
        {
          "clazz": "field",
          "field": "Différence de poids",
          "type": "number-field",
          "shortLabel": "∆ poids",
          "grows": true,
          "span": 2,
          "readonly": false,
          "multiline": false,
          "translate": true,
          "computedProperties": {
            "value": "return new Promise(async (resolve) => {\n\ttry {\n\t\tconst weightNow = parseContent(self[\"Poids\"]?.[0]?.content)\n\t\tconst before = await services({ codeType: 'CD-GYNECOLOGY', code: 'weightbeforepregnancy', limit: 1 })\n\t\tif (!before.length) { resolve(undefined); return }\n\t\tconst pag = parseContent(before[0].content)\n\t\tif (typeof pag !== 'number' || !pag || typeof weightNow !== 'number' || !weightNow) { resolve(undefined); return }\n\t\tresolve(weightNow - pag)\n\t} catch (e) {\n\t\tresolve(undefined)\n\t}\n})"
          }
        },
