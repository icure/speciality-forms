            },
            {
              "clazz": "field",
              "field": "Terme selon ovulation",
              "type": "date-picker",
              "shortLabel": "Terme Fiv",
              "grows": true,
              "span": 8,
              "readonly": false,
              "multiline": false,
              "translate": true,
              "computedProperties": {
                "value": "const asDate = (v) => { if (v instanceof Date) { return v } if (typeof v !== 'number') { return undefined } const s = '' + v; return s.length >= 8 ? new Date(+s.slice(0, 4), +s.slice(4, 6) - 1, +s.slice(6, 8)) : new Date(v) }\nconst addDays = (d, n) => new Date(d.getFullYear(), d.getMonth(), d.getDate() + n)\nconst ovulation = asDate(parseContent(self[\"Date ovulation\"]?.[0]?.content))\nif (!ovulation) { return undefined }\nreturn addDays(ovulation, 266)"
              }
            },
