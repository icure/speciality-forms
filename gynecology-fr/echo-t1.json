            },
            {
              "clazz": "field",
              "field": "Age gestationnel GS",
              "type": "text-field",
              "shortLabel": "AG GS",
              "grows": true,
              "span": 10,
              "readonly": false,
              "multiline": false,
              "translate": true,
              "computedProperties": {
                "value": "const interpolate = (table, v) => {\n\tconst pts = table.split(';').map((p) => p.split(',').map(Number))\n\tif (v <= pts[0][0]) { return pts[0][1] }\n\tfor (let i = 1; i < pts.length; i++) {\n\t\tif (v <= pts[i][0]) { return pts[i - 1][1] + ((v - pts[i - 1][0]) * (pts[i][1] - pts[i - 1][1])) / (pts[i][0] - pts[i - 1][0]) }\n\t}\n\treturn pts[pts.length - 1][1]\n}\nconst toMm = (v) => (v < 1 ? v * 1000 : v)\nconst m = parseContent(self[\"Taille sac gestationnel\"]?.[0]?.content)\nif (typeof m !== 'number') { return undefined }\nconst days = Math.round(interpolate('7,4;8,5;11,6;12,7;13,8;14,9;15,10;16,11;17,12', toMm(m)) * 7)\nreturn '' + Math.floor(days / 7) + ' sem. ' + (days % 7) + ' j.'"
              }
            },
